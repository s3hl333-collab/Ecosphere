# EcoSphere Environment Variables

# Next.js Public Configuration
NEXT_PUBLIC_APP_NAME="EcoSphere"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (optional durable storage). Apply schema.sql before setting both values.
# Keep the service role key server-only. Without it, civic data is held in demo memory.
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Gemini Multimodal API (Optional for local demo mode; required for live AI waste scanning)
# Without a key, only the labeled scanner samples are available.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
